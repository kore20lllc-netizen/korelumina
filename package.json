{
  "name": "korelumina",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev-supervisor.mjs",
    "dev:builder": "npm --workspace apps/lumina-builder run dev",
    "dev:runtime": "npm --workspace apps/lumina-runtime run dev",
    "build": "npm run verify:governed-records && npm run verify:knowledge-doc-governance && npm run verify:knowledge-ui-contract && npm run verify:executive-ui-contract && npm run verify:repo-audit-ui-contract && npm run verify:runtime-operations-ui-contract && npm run verify:import-ui-contract && npm run verify:inhouse-dev-ui-contract && npm run verify:projects-ui-contract && npm run verify:developer-ui-contract && npm run build:packages && npm run typecheck:builder && npm run build:runtime && npm run build:builder",
    "build:builder": "npm --workspace apps/lumina-builder run build",
    "typecheck:builder": "tsc -p apps/lumina-builder/tsconfig.app.json --noEmit",
    "build:packages": "npm --workspace packages/platform-sdk run build && npm --workspace packages/knowledge-platform run build",
    "build:runtime": "npm --workspace apps/lumina-runtime run build",
    "test:runtime": "node scripts/test-runtime.mjs",
    "preview": "npm run preview:builder",
    "preview:builder": "npm --workspace apps/lumina-builder run preview",
    "verify:knowledge-ui-contract": "node scripts/knowledge-ui-contract.mjs",
    "certify:knowledge-ui-contract": "node scripts/knowledge-ui-contract.mjs --write",
    "verify:executive-ui-contract": "node scripts/executive-ui-contract.mjs",
    "certify:executive-ui-contract": "node scripts/executive-ui-contract.mjs --write",
    "verify:repo-audit-ui-contract": "node scripts/repo-audit-ui-contract.mjs",
    "certify:repo-audit-ui-contract": "node scripts/repo-audit-ui-contract.mjs --write",
    "verify:runtime-operations-ui-contract": "node scripts/runtime-operations-ui-contract.mjs",
    "verify:import-ui-contract": "node scripts/import-ui-contract.mjs",
    "certify:import-ui-contract": "node scripts/import-ui-contract.mjs --write",
    "verify:inhouse-dev-ui-contract": "node scripts/inhouse-dev-ui-contract.mjs",
    "certify:inhouse-dev-ui-contract": "node scripts/inhouse-dev-ui-contract.mjs --write",
    "verify:projects-ui-contract": "node scripts/projects-ui-contract.mjs",
    "certify:projects-ui-contract": "node scripts/projects-ui-contract.mjs --write",
    "verify:developer-ui-contract": "node scripts/developer-ui-contract.mjs",
    "certify:developer-ui-contract": "node scripts/developer-ui-contract.mjs --write",
    "certify:runtime-operations-ui-contract": "node scripts/runtime-operations-ui-contract.mjs --write",
    "verify:governed-records": "node scripts/verify-governed-records.mjs",
    "verify:knowledge-doc-governance": "bash scripts/verify-knowledge-operations-doc-governance.sh",
    "education:resolve-authority": "npm --workspace apps/lumina-runtime run education:resolve-authority --",
    "genesis:compact-correlations": "npm --workspace apps/lumina-runtime run genesis:compact-correlations --"
  }
}
