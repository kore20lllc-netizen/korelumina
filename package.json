{
  "name": "korelumina",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev-supervisor.mjs",
    "dev:builder": "npm --workspace apps/lumina-builder run dev",
    "dev:runtime": "npm --workspace apps/lumina-runtime run dev",
    "build": "npm run verify:governed-records && npm run verify:knowledge-doc-governance && npm run verify:knowledge-ui-contract && npm run verify:executive-ui-contract && npm run build:runtime && npm run build:builder",
    "build:builder": "npm --workspace apps/lumina-builder run build",
    "build:runtime": "npm --workspace apps/lumina-runtime run build",
    "preview": "npm run preview:builder",
    "preview:builder": "npm --workspace apps/lumina-builder run preview",
    "verify:knowledge-ui-contract": "node scripts/knowledge-ui-contract.mjs",
    "certify:knowledge-ui-contract": "node scripts/knowledge-ui-contract.mjs --write",
    "verify:executive-ui-contract": "node scripts/executive-ui-contract.mjs",
    "certify:executive-ui-contract": "node scripts/executive-ui-contract.mjs --write",
    "verify:governed-records": "node scripts/verify-governed-records.mjs",
    "verify:knowledge-doc-governance": "bash scripts/verify-knowledge-operations-doc-governance.sh",
    "education:resolve-authority": "npm --workspace apps/lumina-runtime run education:resolve-authority --"
  }
}
