{
  "name": "korelumina",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-supervisor.mjs",
    "dev:builder": "npm --workspace apps/lumina-builder run dev",
    "dev:runtime": "npm --workspace apps/lumina-runtime run dev",
    "build": "npm run build:runtime && npm run build:builder",
    "build:builder": "npm --workspace apps/lumina-builder run build",
    "build:runtime": "npm --workspace apps/lumina-runtime run build",
    "preview": "npm run preview:builder",
    "preview:builder": "npm --workspace apps/lumina-builder run preview"
  }
}
