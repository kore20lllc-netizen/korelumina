  "metadata": {
    "content": "Proceed with Stage 1 — Graph Header, Statistics, and Stable Viewport Shell.\nThis fully rewrites only:\napps/lumina-builder/src/components/workspaces/knowledge/graph/KnowledgeGraphPanel.tsx\nIt must build green before adding the legend and footer.\nBashcat > apps/lumina-builder/src/components/workspaces/knowledge/graph/KnowledgeGraphPanel.tsx <<'EOF'\nimport {\n  Database,\n  Layers3,\n  Maximize2,\n  MousePointer2,\n  Network,\n  RotateCcw,\n  Search,\n  SlidersHorizontal,\n  Waypoints,\n  ZoomIn,\n  ZoomOut,\n} from \"lucide-react\";\n\nimport type {\n  LucideIcon,\n} from \"lucide-react\";\n\nimport type {\n  KnowledgeOperationsSnapshot,\n} from \"@korelumina/platform-sdk\";\n\nimport {\n  LuminaButton,\n} from \"@/components/lumina/LuminaButton\";\n\nexport interface KnowledgeGraphPanelProps {\n  snapshot: KnowledgeOperationsSnapshot | null;\n}\n\ninterface GraphStatistic {\n  label: string;\n  value: string;\n  icon: LucideIcon;\n}\n\nfunction formatNumber(\n  value: number | undefined,\n): string {\n  return value === undefined\n    ? \"—\"\n    : value.toLocaleString();\n}\n\nfunction GraphStatisticCard({\n  label,\n  value,\n  icon: Icon,\n}: GraphStatistic) {\n  return (\n    <div\n      className={[\n        \"flex min-w-0 items-center gap-3 rounded-2xl border px-4 py-3\",\n        \"[border-color:var(--lumina-border-standard)]\",\n        \"[background:var(--lumina-surface-compact)]\",\n        \"[box-shadow:var(--lumina-shadow-panel)]\",\n      ].join(\" \")}\n    >\n      <div\n        className={[\n          \"flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border\",\n          \"[border-color:var(--lumina-border-standard)]\",\n          \"[background:var(--lumina-surface-interactive)]\",\n        ].join(\" \")}\n      >\n        <Icon\n          className=\"h-4 w-4 text-muted-foreground\"\n          strokeWidth={1.75}\n        />\n      </div>\n\n      <div className=\"min-w-0\">\n        <div className=\"truncate text-[10px] font-semibold uppercase tracking-[0.16em] text-muted-foreground\">\n          {label}\n        </div>\n\n        <div className=\"mt-0.5 text-lg font-semibold tabular-nums\">\n          {value}\n        </div>\n      </div>\n    </div>\n  );\n}\n\nexport function KnowledgeGraphPanel({\n  snapshot,\n}: KnowledgeGraphPanelProps) {\n  const statistics: GraphStatistic[] = [\n    {\n      label: \"Nodes\",\n      value: formatNumber(\n        snapshot?.summary.totalKnowledgeItems,\n      ),\n      icon: Network,\n    },\n    {\n      label: \"Edges\",\n      value: \"—\",\n      icon: Waypoints,\n    },\n    {\n      label: \"Connected\",\n      value: \"—\",\n      icon: Layers3,\n    },\n    {\n      label: \"Selected\",\n      value: \"0\",\n      icon: MousePointer2,\n    },\n  ];\n\n  return (\n    <section\n      aria-label=\"Knowledge Graph workspace\"\n      className={[\n        \"flex h-full min-h-[34rem] flex-col overflow-hidden rounded-[32px]\",\n        \"lg:h-[clamp(34rem,68vh,48rem)]\",\n      ].join(\" \")}\n    >\n      <header\n        className={[\n          \"shrink-0 border-b px-5 py-5\",\n          \"[border-color:var(--lumina-border-standard)]\",\n          \"[background:var(--lumina-surface-compact)]\",\n          \"[backdrop-filter:var(--lumina-blur-surface)]\",\n        ].join(\" \")}\n      >\n        <div className=\"flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between\">\n          <div className=\"flex min-w-0 items-center gap-3\">\n            <div\n              className={[\n                \"flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl border\",\n                \"[border-color:var(--lumina-border-emphasis)]\",\n                \"[background:var(--lumina-surface-selected)]\",\n                \"[box-shadow:var(--lumina-shadow-selected)]\",\n              ].join(\" \")}\n            >\n              <Network\n                className=\"h-5 w-5 text-cyan\"\n                strokeWidth={1.75}\n              />\n            </div>\n\n            <div className=\"min-w-0\">\n              <div className=\"text-[10px] font-semibold uppercase tracking-[0.22em] text-cyan\">\n                Intelligence topology\n              </div>\n\n              <h2 className=\"mt-1 truncate text-xl font-semibold tracking-tight\">\n                Knowledge Graph\n              </h2>\n            </div>\n          </div>\n\n          <div className=\"flex min-w-0 flex-1 flex-wrap items-center gap-2 xl:max-w-[760px] xl:justify-end\">\n            <label className=\"relative min-w-[220px] flex-1 xl:max-w-[280px]\">\n              <span className=\"sr-only\">\n                Search graph entities\n              </span>\n\n              <Search\n                className=\"pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground\"\n                strokeWidth={1.75}\n              />\n\n              <input\n                type=\"search\"\n                disabled\n                placeholder=\"Search entities…\"\n                className={[\n                  \"h-9 w-full rounded-xl border pl-9 pr-3 text-xs outline-none\",\n                  \"disabled:cursor-not-allowed disabled:opacity-70\",\n                  \"[border-color:var(--lumina-border-standard)]\",\n                  \"[background:var(--lumina-surface-interactive)]\",\n                  \"placeholder:text-muted-foreground\",\n                ].join(\" \")}\n              />\n            </label>\n\n            <LuminaButton\n              type=\"button\"\n              variant=\"toolbar\"\n              size=\"sm\"\n              disabled\n            >\n              <SlidersHorizontal className=\"h-3.5 w-3.5\" />\n              Filters\n            </LuminaButton>\n\n            <select\n              aria-label=\"Graph layout\"\n              disabled\n              defaultValue=\"force\"\n              className={[\n                \"h-9 rounded-xl border px-3 text-xs outline-none\",\n                \"disabled:cursor-not-allowed disabled:opacity-70\",\n                \"[border-color:var(--lumina-border-standard)]\",\n                \"[background:var(--lumina-surface-interactive)]\",\n              ].join(\" \")}\n            >\n              <option value=\"force\">\n                Force layout\n              </option>\n\n              <option value=\"hierarchy\">\n                Hierarchy\n              </option>\n\n              <option value=\"radial\">\n                Radial\n              </option>\n            </select>\n\n            <div className=\"flex items-center gap-1\">\n              <LuminaButton\n                type=\"button\"\n                variant=\"ghost\"\n                size=\"icon\"\n                disabled\n                aria-label=\"Zoom out\"\n              >\n                <ZoomOut className=\"h-4 w-4\" />\n              </LuminaButton>\n\n              <LuminaButton\n                type=\"button\"\n                variant=\"ghost\"\n                size=\"icon\"\n                disabled\n                aria-label=\"Zoom in\"\n              >\n                <ZoomIn className=\"h-4 w-4\" />\n              </LuminaButton>\n\n              <LuminaButton\n                type=\"button\"\n                variant=\"ghost\"\n                size=\"icon\"\n                disabled\n                aria-label=\"Fit graph to viewport\"\n              >\n                <Maximize2 className=\"h-4 w-4\" />\n              </LuminaButton>\n\n              <LuminaButton\n                type=\"button\"\n                variant=\"ghost\"\n                size=\"icon\"\n                disabled\n                aria-label=\"Reset graph viewport\"\n              >\n                <RotateCcw className=\"h-4 w-4\" />\n              </LuminaButton>\n            </div>\n          </div>\n        </div>\n      </header>\n\n      <div\n        className={[\n          \"grid shrink-0 grid-cols-2 gap-3 border-b p-4 md:grid-cols-4\",\n          \"[border-color:var(--lumina-border-standard)]\",\n        ].join(\" \")}\n      >\n        {statistics.map(\n          (statistic) => (\n            <GraphStatisticCard\n              key={statistic.label}\n              {...statistic}\n            />\n          ),\n        )}\n      </div>\n\n      <div className=\"relative flex min-h-0 flex-1 overflow-hidden\">\n        <div\n          aria-hidden=\"true\"\n          className={[\n            \"pointer-events-none absolute inset-0\",\n            \"[background:radial-gradient(circle_at_50%_42%,rgba(124,92,255,0.2),transparent_32%),radial-gradient(circle_at_72%_64%,rgba(34,211,238,0.12),transparent_30%)]\",\n          ].join(\" \")}\n        />\n\n        <div\n          aria-hidden=\"true\"\n          className={[\n            \"pointer-events-none absolute inset-0 opacity-70\",\n            \"[background-image:linear-gradient(rgba(255,255,255,0.035)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.035)_1px,transparent_1px)]\",\n            \"[background-size:40px_40px]\",\n          ].join(\" \")}\n        />\n\n        <div\n          aria-hidden=\"true\"\n          className=\"pointer-events-none absolute inset-x-0 top-1/2 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent\"\n        />\n\n        <div\n          aria-hidden=\"true\"\n          className=\"pointer-events-none absolute inset-y-0 left-1/2 w-px bg-gradient-to-b from-transparent via-white/10 to-transparent\"\n        />\n\n        <div className=\"absolute left-4 top-4 text-[9px] font-medium uppercase tracking-[0.18em] text-muted-foreground/70\">\n          X −500 · Y +500\n        </div>\n\n        <div className=\"absolute bottom-4 right-4 text-[9px] font-medium uppercase tracking-[0.18em] text-muted-foreground/70\">\n          X +500 · Y −500\n        </div>\n\n        <div className=\"relative z-10 flex min-h-0 flex-1 items-center justify-center p-8\">\n          <div className=\"max-w-md text-center\">\n            <div className=\"relative mx-auto flex h-24 w-24 items-center justify-center\">\n              <span\n                aria-hidden=\"true\"\n                className=\"absolute inset-0 rounded-full border border-violet/30 bg-violet/10 shadow-[0_0_80px_rgba(124,92,255,0.28)]\"\n              />\n\n              <span\n                aria-hidden=\"true\"\n                className=\"absolute -inset-5 rounded-full border border-dashed border-cyan/20\"\n              />\n\n              <Network\n                className=\"relative h-9 w-9 text-violet-200\"\n                strokeWidth={1.5}\n              />\n            </div>\n\n            <h3 className=\"mt-7 text-2xl font-semibold tracking-tight\">\n              Knowledge Graph Ready\n            </h3>\n\n            <p className=\"mt-3 text-sm leading-6 text-muted-foreground\">\n              The governed graph viewport is prepared for authoritative\n              repositories, evidence, canonical memory, reasoning, and\n              runtime relationships.\n            </p>\n\n            <div className=\"mt-6 flex flex-wrap items-center justify-center gap-2\">\n              <LuminaButton\n                type=\"button\"\n                variant=\"glow\"\n                size=\"sm\"\n                disabled\n              >\n                <Search className=\"h-3.5 w-3.5\" />\n                Explore knowledge\n              </LuminaButton>\n\n              <LuminaButton\n                type=\"button\"\n                variant=\"ghost\"\n                size=\"sm\"\n                disabled\n              >\n                <Database className=\"h-3.5 w-3.5\" />\n                Acquire evidence\n              </LuminaButton>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}\n\nexport default KnowledgeGraphPanel;\nEOF\n\necho \"===== STAGE 1 GRAPH PANEL =====\"\n\nsed -n '1,360p' \\\napps/lumina-builder/src/components/workspaces/knowledge/graph/KnowledgeGraphPanel.tsx\n\necho \"====================\"\n\ngit diff --check\n\necho \"====================\"\n\nnpm --workspace apps/lumina-builder run build\n\necho \"====================\"\n\nnpm --workspace apps/lumina-runtime run build\nStop after the build output. Stage 2 adds the legend, minimap, and footer only after this exact file is green.",
